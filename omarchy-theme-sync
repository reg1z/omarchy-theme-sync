#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="$HOME/.config"
THEME_DIR="$CONFIG_DIR/omarchy/current"
SYNC_DIR="$CONFIG_DIR/omarchy-theme-sync"
THEME_STORE="$HOME/.local/share/omarchy/themes"

COLORS_FILE=""

load_colors() {
    COLORS_FILE=""

    # Identify current theme
    if [[ -f "$THEME_DIR/theme.name" ]]; then
        THEME_NAME=$(tr -d '[:space:]' < "$THEME_DIR/theme.name")

        if [[ -f "$THEME_DIR/theme/colors.toml" ]]; then
            COLORS_FILE="$THEME_DIR/theme/colors.toml"
        fi
    fi

    # Fallback to system default
    if [[ -z "$COLORS_FILE" || ! -f "$COLORS_FILE" ]]; then
        echo "Theme colors not found, using system default..."

        mode=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo "'prefer-light'")
        if [[ $mode == "'prefer-dark'" ]]; then
            DEFAULT="catppuccin-mocha"
        else
            DEFAULT="catppuccin-latte"
        fi

        COLORS_FILE="$SYNC_DIR/colors/$DEFAULT/colors.toml"
    fi

    if [[ ! -f "$COLORS_FILE" ]]; then
        echo "ERROR: colors.toml not found: $COLORS_FILE" >&2
        exit 1
    fi

    echo "Using colors from: $COLORS_FILE"
}

ensure_user_pref() {
    local profile="$1" pref="$2" value="$3"
    local user_js="$profile/user.js"
    local pref_line="user_pref(\"$pref\", $value);"

    if [[ -f "$user_js" ]]; then
        if grep -qxF "$pref_line" "$user_js"; then
            return
        fi
        if grep -qF "$pref" "$user_js"; then
            grep -vF "$pref" "$user_js" > "$user_js.tmp" && mv "$user_js.tmp" "$user_js"
        fi
        echo "$pref_line" >> "$user_js"
    else
        echo "$pref_line" > "$user_js"
    fi
}

sync_mozilla() {
    local tmp="$1"
    local mozCfg="$2"
    local browser="$3"
    local profiles=()

    if [[ ! -f "$mozCfg/profiles.ini" ]]; then
        echo "$browser profiles.ini not found, skipping..."
        return
    fi

    # Load profignore entries then remove from tmp to avoid copying into chrome dirs
    local ignored_profiles=()
    if [[ -f "$tmp/profignore" ]]; then
        while IFS= read -r ignore_line || [[ -n "$ignore_line" ]]; do
            ignore_line="${ignore_line%%$'\r'}"
            [[ -z "$ignore_line" || "$ignore_line" =~ ^# ]] && continue
            ignored_profiles+=("$ignore_line")
        done < "$tmp/profignore"
        rm -f "$tmp/profignore"
    fi

    local name="" path="" is_relative=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%$'\r'}"

        if [[ "$line" =~ ^\[Profile ]] || [[ "$line" =~ ^\[ ]]; then
            if [[ -n "$path" ]]; then
                local resolved
                if [[ "$is_relative" == "1" ]]; then
                    resolved="$mozCfg/$path"
                else
                    resolved="$path"
                fi
                profiles+=("$name|$path|$resolved")
            fi
            name=""
            path=""
            is_relative=""
        elif [[ "$line" =~ ^Name= ]]; then
            name="${line#Name=}"
        elif [[ "$line" =~ ^Path= ]]; then
            path="${line#Path=}"
        elif [[ "$line" =~ ^IsRelative= ]]; then
            is_relative="${line#IsRelative=}"
        fi
    done < "$mozCfg/profiles.ini"

    # Capture the last profile
    if [[ -n "$path" ]]; then
        local resolved
        if [[ "$is_relative" == "1" ]]; then
            resolved="$mozCfg/$path"
        else
            resolved="$path"
        fi
        profiles+=("$name|$path|$resolved")
    fi

    # Track which profignore entries matched
    local matched_ignores=()

    for entry in "${profiles[@]}"; do
        local prof_name="${entry%%|*}"
        local rest="${entry#*|}"
        local raw_path="${rest%%|*}"
        local profile="${rest#*|}"

        # Check profignore
        local ignored=false
        for ignore_entry in "${ignored_profiles[@]}"; do
            if [[ "$ignore_entry" == "$prof_name" || "$ignore_entry" == "$raw_path" || "$ignore_entry" == "$profile" ]]; then
                echo "Skipping $browser profile '$prof_name' (ignored by profignore)"
                ignored=true
                matched_ignores+=("$ignore_entry")
                break
            fi
        done
        [[ "$ignored" == true ]] && continue

        if [[ ! -d "$profile" ]]; then
            echo "Profile directory $profile not found, skipping..."
            continue
        fi

        # Detect active theme via extensions.json and reset if non-default
        if [[ -f "$profile/extensions.json" ]]; then
            active_theme=$(jq -r '.addons[] | select(.type == "theme" and .active == true) | .id' "$profile/extensions.json" 2>/dev/null || echo "")

            if [[ -n "$active_theme" && "$active_theme" != "default-theme@mozilla.org" ]]; then
                echo "Non-default theme detected ($active_theme) in $profile, resetting to default..."
                jq '
                    (.addons[] | select(.type == "theme" and .active == true)) |= (.active = false | .userDisabled = true) |
                    (.addons[] | select(.type == "theme" and .id == "default-theme@mozilla.org")) |= (.active = true | .userDisabled = false)
                ' "$profile/extensions.json" > "$profile/extensions.json.tmp" \
                    && mv "$profile/extensions.json.tmp" "$profile/extensions.json"
            fi
        fi

        # Ensure required prefs in user.js
        ensure_user_pref "$profile" "toolkit.legacyUserProfileCustomizations.stylesheets" "true"
        ensure_user_pref "$profile" "extensions.activeThemeID" '"default-theme@mozilla.org"'
        ensure_user_pref "$profile" "layout.css.prefers-color-scheme.content-override" "2"

        # Ensure chrome directory exists and copy processed files
        mkdir -p "$profile/chrome"
        cp -af "$tmp"/. "$profile/chrome/"

        echo "Synced $browser theme to $profile"
    done

    # Warn about unmatched profignore entries
    for ignore_entry in "${ignored_profiles[@]}"; do
        local was_matched=false
        for m in "${matched_ignores[@]}"; do
            if [[ "$m" == "$ignore_entry" ]]; then
                was_matched=true
                break
            fi
        done
        if [[ "$was_matched" == false ]]; then
            echo "Warning: profignore entry '$ignore_entry' did not match any $browser profile in $mozCfg"
        fi
    done
}


replace_vars() {
    local src="$SYNC_DIR"

    find "$src" -mindepth 1 -maxdepth 1 -type d | while read -r sub; do
        if [[ ! -f "$sub/dir" ]]; then
            echo "No dir file in $sub, skipping..."
            continue
        fi

        # Add multi-line parsing here
        numlines=$(wc -l < "$sub/dir")
        
        # Apply templates to every line-delimited path in "dir"
        for (( i = 1; i <= numlines; i++ )); do
            line=$(sed -n ""$i"p" "$sub/dir")
            raw_dest="${line//\~/$HOME}"

            if [[ -z "$raw_dest" ]]; then
                echo "Empty dir file in $sub, skipping..."
                continue
            fi

            dest=$(eval echo "$raw_dest")
            if [[ ! -d "$dest" ]]; then
                echo -e "\n$dest not found skipping"
                continue
            fi

            tmp=$(mktemp -d)

            # Copy config templates (exclude dir)
            cp -a "$sub"/. "$tmp/"
            rm -f "$tmp/dir"

            echo -e "\nreplacing $sub to $dest"
            # Extract placeholders and replace
            grep -rhoP '\$\{\K[^}]+' "$tmp" | sort -u | while read -r var; do
                value=$(grep -E "^$var\s*=" "$COLORS_FILE" \
                    | cut -d'=' -f2- \
                    | tr -d ' "')

                if [[ -n "$value" ]]; then
                    find "$tmp" -type f -exec sed -i "s|\${$var}|$value|g" {} +
                fi
            done

            name="$(basename "$sub")"
            # Copy into destination
            if [[ "$name" == "firefox" ]]; then
                sync_mozilla "$tmp" "$raw_dest" "$name"
            elif [[ "$name" == "waterfox" ]]; then
                sync_mozilla "$tmp" "$raw_dest" "$name"
            elif [[ "$name" == "librewolf" ]]; then
                sync_mozilla "$tmp" "$raw_dest" "$name"
            elif [[ "$name" == "zen-browser" ]]; then
                sync_mozilla "$tmp" "$raw_dest" "$name"
            else
                cp -af "$tmp"/. "$dest/"
            fi
            rm -rf "$tmp"
        done

    done
}

echo "Theme change detected. Syncing..."
load_colors
replace_vars 

echo -e "\nSynchronization Complete."
